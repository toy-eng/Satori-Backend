# Copy this file to `.env` for local development.
# Render injects these values at build/runtime (see render.yaml).

# --- Database -------------------------------------------------------------
# Local Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/survey_system"
# Render internal URL (no SSL required):
# DATABASE_URL="postgresql://survey_user:password@dpg-xxxxxxxx-a/survey_system"
# Render external URL (SSL is auto-enabled for `sslmode=require`):
# DATABASE_URL="postgresql://user:password@host:5432/survey_system?sslmode=require"

# --- Auth -----------------------------------------------------------------
# Secret used to sign JWT access tokens. Use a long random string.
JWT_SECRET="replace-with-a-long-random-string"

# --- CORS -----------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS="https://satori-inky.vercel.app,http://localhost:5173"

# --- Optional -------------------------------------------------------------
# Force Postgres SSL on or off. Leave unset to auto-detect from DATABASE_URL.
# DATABASE_SSL="true"

# Render provides PORT automatically; only set it when running locally.
# PORT="3000"
